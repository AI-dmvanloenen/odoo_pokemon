{
    "flake8.args": [
        "--max-line-length=180",
        "--ignore=E402,F841,F401,E302,E305,W503"
    ],
    "autopep8.args": [
        "--max-line-length=200"
    ],
    "editor.formatOnSave": true,
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "none"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.gitkeep": true,
        "**/*.pyc": true
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8"
    },
    "xml.format.preserveAttributeLineBreaks": true,
    "xml.format.maxLineWidth": 300
}
